<Project Sdk="Microsoft.NET.Sdk">
  <!-- App name, identity and version come from ..\Source\Resources\Identity.props. -->
  <Import Project="..\Source\Resources\Identity.props" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-ios</TargetFramework>
    <SupportedOSPlatformVersion>12.2</SupportedOSPlatformVersion>
    <CodesignKey>iPhone Developer</CodesignKey>
    <MonoGamePlatform>iOS</MonoGamePlatform>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\Source\**\*.cs" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\Source\Resources\iOS\Info.plist">
      <Link>Info.plist</Link>
    </None>
    <ImageAsset Include="..\Source\Resources\iOS\AppIcon.xcassets\**\*">
      <Link>AppIcon.xcassets\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </ImageAsset>
    <ImageAsset Include="..\Source\Resources\Icon.png">
      <Link>AppIcon.xcassets\AppIcon.appiconset\icon_1024x1024.png</Link>
    </ImageAsset>
  </ItemGroup>
  <ItemGroup>
    <UpToDateCheckInput Include="..\Content\Assets\**\*" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.iOS" />
  </ItemGroup>
  <Import Project="..\Content\BuildContent.targets" />
</Project>
