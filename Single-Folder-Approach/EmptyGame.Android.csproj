<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>21</SupportedOSPlatformVersion>
    <MonoGamePlatform>Android</MonoGamePlatform>
  </PropertyGroup>
  <PropertyGroup>
    <!-- The Android resource tree (drawable-*, values) lives under Resources\Android instead of the default Resources\. -->
    <MonoAndroidResourcePrefix>Resources\Android</MonoAndroidResourcePrefix>
    <AndroidManifest>Resources\Android\AndroidManifest.xml</AndroidManifest>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Source\**\*.cs" />
  </ItemGroup>
  <ItemGroup>
    <AndroidResource Include="Resources\Android\**\*" Exclude="Resources\Android\AndroidManifest.xml" />
    <None Include="Resources\Identity.props" />
    <None Include="Resources\Android\AndroidManifest.xml" />
  </ItemGroup>
  <ItemGroup>
    <UpToDateCheckInput Include="Content\Assets\**\*" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.Android" />
  </ItemGroup>
  <Import Project="Content\BuildContent.targets" />
</Project>
