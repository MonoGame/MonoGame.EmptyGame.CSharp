<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RollForward>Major</RollForward>
    <PublishReadyToRun>false</PublishReadyToRun>
    <TieredCompilation>false</TieredCompilation>
    <MonoGamePlatform>DesktopVK</MonoGamePlatform>
  </PropertyGroup>
  <PropertyGroup>
    <ApplicationManifest>Resources\Windows\app.manifest</ApplicationManifest>
    <ApplicationIcon>Resources\Icon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Source\**\*.cs" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Resources\Icon.ico" LogicalName="Icon.ico" />
    <EmbeddedResource Include="Resources\Icon.bmp" LogicalName="Icon.bmp" />
    <None Include="Resources\Identity.props" />
    <None Include="Resources\Windows\app.manifest" />
    <None Include="Resources\macOS\**\*" />
  </ItemGroup>
  <ItemGroup>
    <UpToDateCheckInput Include="Content\Assets\**\*" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.Native" />
    <PackageReference Include="MonoGame.Runtime.Windows.Vulkan" />
    <PackageReference Include="MonoGame.Runtime.Mac.Vulkan" />
    <PackageReference Include="MonoGame.Runtime.Linux.Vulkan" />
  </ItemGroup>
  <Import Project="Content\BuildContent.targets" />
</Project>
